---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import SubLayout from '../../layouts/SubLayout.astro';
import PostView from '../../components/PostView.astro';
import '../../styles/legacy/board-lecture.css';
import { LECTURE, isLocale, slugOf, sortPosts, type PostEntry } from '../../lib/content.ts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection(LECTURE.collection, isLocale('ko')));
  // Neighbours in list order (newest first): 이전글 is the row above, 다음글 the row below.
  return posts.map((entry, i) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  entry: PostEntry;
  prev?: PostEntry;
  next?: PostEntry;
}

const { entry, prev, next } = Astro.props;
---

<SubLayout
  title={LECTURE.label}
  docTitle={`${entry.data.title} > ${LECTURE.label}`}
  sectionKey="lecture"
  currentHref={LECTURE.base}
>
  <PostView entry={entry} base={LECTURE.base} locale="ko" prev={prev} next={next} />
</SubLayout>
