---
interface Props {
  tabs: Array<{ label: string; href: string; active: boolean }>;
  /** `members`: the member boards' `ul.class_area`; `board`: the list boards' `ul#bo_cate_ul`. */
  variant: 'members' | 'board';
}

const { tabs, variant } = Astro.props;
// The legacy skins highlight the active tab through `#bo_cate #bo_cate_on`; `.active` has no rule of its own.
---

<nav id="bo_cate">
  <ul class={variant === 'members' ? 'class_area' : undefined} id={variant === 'board' ? 'bo_cate_ul' : undefined}>
    {
      tabs.map((tab) => (
        <li>
          <a href={tab.href} class={tab.active ? 'active' : undefined} id={tab.active ? 'bo_cate_on' : undefined}>
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
